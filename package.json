{
  "name": "git-stash-manager",
  "displayName": "Git Stash Manager",
  "description": "A visual Git stash inspector for VS Code that helps you find, inspect, and understand stashes without leaving the editor.",
  "version": "0.1.0",
  "publisher": "git-stash-manager-official",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tesserato-Software/git-stash-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Tesserato-Software/git-stash-manager/issues"
  },
  "homepage": "https://github.com/Tesserato-Software/git-stash-manager#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "stash",
    "scm",
    "diff"
  ],
  "main": "./dist/extension/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "gitStashManager.open",
        "title": "Git Stash Manager: Open"
      }
    ]
  },
  "scripts": {
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:webview": "vite build",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "tsc -p tsconfig.extension.json --watch",
    "watch:webview": "vite build --watch",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
